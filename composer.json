{
    "name": "joberne224/zara-framework",
    "description": "Zara - Un micro-framework PHP moderne, léger et extensible",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "framework",
        "micro-framework",
        "php"
    ],
    "autoload": {
        "psr-4": {
            "Zara\\": "src/"
        },
        "files": [
            "src/Core/Debug/helpers.php",
            "src/Internal/pre_boot_errors.php"
        ]
    },
    "require": {
        "php": "^8.2",
        "symfony/yaml": "^5.4",
        "vlucas/phpdotenv": "^5.6",
        "psr/container": "^2.0",
        "psr/log": "^3.0",
        "monolog/monolog": "^3.10",
        "symfony/console": "^7.4",
        "psr/simple-cache": "^3.0",
        "psr/http-message": "^2.0",
        "psr/http-factory": "^1.1",
        "psr/event-dispatcher": "^1.0"
    },
    "suggest": {
        "ext-redis": "Required to use Zara\\Cache\\Driver\\RedisCache. Install via PECL or your OS package manager."
    },
    "authors": [
        {
            "name": "Joberne Ngambe"
        }
    ]
}
